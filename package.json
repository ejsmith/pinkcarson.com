{
  "name": "carson-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/prepare-images.mjs",
    "icons": "node scripts/prepare-icons.mjs",
    "resume": "node scripts/build-resume.mjs",
    "resume:private": "node scripts/build-resume.mjs --private",
    "dev": "npm run resume && vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run resume && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "pdfkit": "0.20.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "sirv": "^3.0.2"
  }
}
